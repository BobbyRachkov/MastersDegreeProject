<UserControl x:Class="MastersProject.App.Views.PortSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MastersProject.App.Views"
             xmlns:converters="clr-namespace:MastersProject.App.Converters"
             xmlns:portSelector="clr-namespace:MastersProject.App.ViewModels.PortSelector"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=portSelector:PortSelectorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BooleanToVisibilityConverter Invert="True" x:Key="InvertedBooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <ListView
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Grid.Row="0"
            ItemsSource="{Binding Ports}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Focusable" Value="false"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <ItemContainerTemplate DataType="{x:Type portSelector:PortViewModel}">
                    <Grid
                        HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock 
                            Margin="10"
                            Grid.Column="0"
                            Text="{Binding Name}"/>
                        <Grid
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Grid.Column="1">
                            <fa:FontAwesome
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Foreground="Red"
                                Visibility="{Binding IsCheckSuccessful,Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                Icon="Close"/>
                            <fa:FontAwesome
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Foreground="Green"
                                Visibility="{Binding IsCheckSuccessful,Converter={StaticResource BooleanToVisibilityConverter}}"
                                Icon="Check"/>
                            <fa:FontAwesome
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Visibility="{Binding IsCheckInProgress,Converter={StaticResource BooleanToVisibilityConverter}}"
                                Icon="Spinner"/>
                        </Grid>
                        <Button 
                            Visibility="{Binding IsCheckSuccessful,Converter={StaticResource BooleanToVisibilityConverter}}"
                            Height="30"
                            Width="30"
                            Grid.Column="2"
                            Command="{Binding UsePortCommand}">
                            <fa:FontAwesome
                                Icon="ChevronRight"/>
                        </Button>
                    </Grid>
                </ItemContainerTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button
            Margin="3"
            Padding="10"
            Command="{Binding RefreshPortsCommand}"
            Grid.Column="0">
                Refresh ports
            </Button>
            <Button
                Margin="3"
                Padding="10"
                Command="{Binding RerunChecksCommand}"
            Grid.Column="1">
                Rerun checks
            </Button>
        </Grid>
    </Grid>
</UserControl>
